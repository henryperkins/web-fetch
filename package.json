{
  "name": "web-fetch-mcp",
  "version": "1.0.0",
  "description": "MCP server for safe, high-signal web browsing and content fetching for LLM agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "web-fetch-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:smoke": "vitest run tests/integration/ai-search-smoke.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@aws-sdk/client-s3": "^3.1010.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^17.3.1",
    "fast-xml-parser": "^4.5.4",
    "jsdom": "^24.1.3",
    "pdfjs-dist": "^4.10.38",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^6.24.1",
    "yaml": "^2.8.2"
  },
  "optionalDependencies": {
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.0",
    "@types/node": "^20.19.37",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "web-fetch",
    "llm",
    "content-extraction",
    "playwright"
  ],
  "license": "MIT"
}
